# ExchangeWatch AI Configuration

# Telegram — Private Bot Chat (development, personal alerts)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Telegram — Channel (public ExchangeWatch alert feed)
# Set TELEGRAM_CHANNEL_ENABLED=true and set TELEGRAM_CHANNEL_ID to enable.
# The bot must be an administrator of the channel with "Post Messages" permission.
# TELEGRAM_CHANNEL_ID can be @channelname or a numeric ID like -1001234567890
TELEGRAM_CHANNEL_ENABLED=false
TELEGRAM_CHANNEL_ID=

# Polling Interval (seconds)
POLL_INTERVAL_SECONDS=15

# Local AI Configuration (Ollama)
LOCAL_AI_ENABLED=true
LOCAL_AI_URL=http://localhost:11434/api/generate
LOCAL_AI_MODEL=llama3.2:1b

# Storage Paths
DATABASE_PATH=data/exchangewatch.db
EXCEL_OUTPUT_PATH=output/ExchangeWatch_AI_Alerts.xlsx
CSV_OUTPUT_PATH=output/ExchangeWatch_AI_Alerts.csv

# Logging
LOG_LEVEL=INFO
